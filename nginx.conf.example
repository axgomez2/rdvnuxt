# ===========================================
# Configuração Nginx - RDV Discos Frontend
# ===========================================
#
# INSTALAÇÃO:
#   1. Copie este arquivo para /etc/nginx/sites-available/rdv-frontend
#   2. Edite o server_name com seu domínio
#   3. Crie link simbólico: sudo ln -s /etc/nginx/sites-available/rdv-frontend /etc/nginx/sites-enabled/
#   4. Teste: sudo nginx -t
#   5. Recarregue: sudo systemctl reload nginx
#
# SSL (HTTPS):
#   Após configurar, execute:
#   sudo certbot --nginx -d seudominio.com -d www.seudominio.com
#
# ===========================================

server {
    listen 80;
    listen [::]:80;
    
    # Substitua pelo seu domínio
    server_name seudominio.com www.seudominio.com;

    # Logs
    access_log /var/log/nginx/rdv-frontend.access.log;
    error_log /var/log/nginx/rdv-frontend.error.log;

    # Tamanho máximo de upload (ajuste conforme necessário)
    client_max_body_size 10M;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/x-javascript application/xml application/json;
    gzip_disable "MSIE [1-6]\.";

    # Proxy para o Nuxt (SSR)
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        
        # WebSocket support (para HMR em dev, mas bom ter em prod também)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        
        # Headers importantes
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Cache bypass
        proxy_cache_bypass $http_upgrade;
        
        # Timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Cache para assets estáticos
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        
        # Cache de 1 ano para assets com hash
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Bloquear acesso a arquivos sensíveis
    location ~ /\. {
        deny all;
    }
}

# ===========================================
# Configuração com SSL (após certbot)
# O certbot modifica automaticamente, mas aqui está um exemplo:
# ===========================================
#
# server {
#     listen 443 ssl http2;
#     listen [::]:443 ssl http2;
#     server_name seudominio.com www.seudominio.com;
#
#     ssl_certificate /etc/letsencrypt/live/seudominio.com/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/seudominio.com/privkey.pem;
#     include /etc/letsencrypt/options-ssl-nginx.conf;
#     ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
#
#     # ... resto da configuração igual acima ...
# }
#
# server {
#     listen 80;
#     server_name seudominio.com www.seudominio.com;
#     return 301 https://$server_name$request_uri;
# }
