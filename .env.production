# Configurações de Produção - RDV Discos Frontend
# Copie este arquivo para .env no servidor de produção

# URL da API Laravel (ajuste para seu domínio)
NUXT_PUBLIC_API_BASE=https://api.seudominio.com/api

# Porta do servidor Nuxt (padrão 3000)
PORT=3000

# Host (0.0.0.0 para aceitar conexões externas)
HOST=0.0.0.0

# Ambiente
NODE_ENV=production
